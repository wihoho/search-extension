{
  "manifest_version": 3,
  "name": "OmniSearch",
  "version": "2.0.0",
  "description": "Quick search shortcuts for popular websites directly from Chrome's address bar",
  "permissions": [
    "storage",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["automation-script.js", "element-selector.js", "sidebar.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "OmniSearch Settings",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "commands": {
    "toggle-sidebar": {
      "suggested_key": {
        "default": "Ctrl+Shift+S",
        "mac": "Command+Shift+S"
      },
      "description": "Toggle OmniSearch sidebar"
    }
  },
  "omnibox": {
    "keyword": "os"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": ["welcome.html", "debug.html", "automation-script.js", "sidebar.css", "icons/*"],
      "matches": ["<all_urls>"]
    }
  ]
}
